--- !u!114 &1126677759
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1126677757}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dcb1b89f8ba15d848ae37de22bc05f02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlossaryDemo.Patterns.GuidePages
  titleText: {fileID: 56152254}
  bodyText: {fileID: 114219364}
  pageText: {fileID: 1555561240}
  titles:
  - 1. Custom Editor
  - "2. Undo \uC9C0\uC6D0"
  - 3. EditorWindow
  - "4. Scene \uBDF0 \uD578\uB4E4"
  bodies:
  - "<color=#9BE89B>[CustomEditor(typeof(EnemySpawnerTool))]\nclass EnemySpawnerToolEditor : Editor\n{\n  public override void OnInspectorGUI()\n  {\n    DrawDefaultInspector();\n    if (GUILayout.Button(\"\uC801 10\uB9C8\uB9AC \uC0DD\uC131\"))\n      Spawn();\n  }\n}</color>\n\n\u2022 \uD30C\uC77C\uC740 \uBC18\uB4DC\uC2DC <b>Editor</b> \uD3F4\uB354\uC5D0\n  (\uBE4C\uB4DC\uC5D0\uC11C \uBE60\uC9D0)"
  - "\uC5D0\uB514\uD130\uC5D0\uC11C \uB9CC\uB4E0 \uC624\uBE0C\uC81D\uD2B8\uB294\n<color=#9BE89B>Undo.RegisterCreatedObjectUndo(go, \"\uC801 \uC0DD\uC131\");</color>\n\n\uC9C0\uC6B8 \uB54C\uB294\n<color=#9BE89B>Undo.DestroyObjectImmediate(go);</color>\n\n\uD504\uB9AC\uD339 \uC5F0\uACB0 \uC720\uC9C0:\n<color=#9BE89B>PrefabUtility.InstantiatePrefab(prefab)</color>\n\n\uC52C \uC800\uC7A5 \uD45C\uC2DC:\n<color=#9BE89B>EditorSceneManager.MarkSceneDirty()</color>"
  - "<color=#9BE89B>class EnemySpawnerWindow : EditorWindow\n{\n  [MenuItem(\"Tools/.../Enemy Spawner Window\")]\n  static void Open() =>\n    GetWindow<EnemySpawnerWindow>();\n\n  void OnGUI() { \uC2AC\uB77C\uC774\uB354\xB7\uBC84\uD2BC }\n}</color>\n\n\u2022 \uBA54\uB274\uC5D0\uC11C \uC5EC\uB294 \uB3C5\uB9BD \uCC3D\n\u2022 \uC5EC\uB7EC \uC624\uBE0C\uC81D\uD2B8\uB97C \uD55C \uBC88\uC5D0 \uB2E4\uB8E8\uB294 \uD234\uC5D0 \uC801\uD569"
  - "Custom Editor \uC758 <color=#9BE89B>OnSceneGUI()</color> \uC5D0\uC11C\n<color=#9BE89B>Handles.RadiusHandle(...)</color>\n\uB85C \uBC18\uC9C0\uB984\uC744 Scene \uBDF0\uC5D0\uC11C \uB9C8\uC6B0\uC2A4\uB85C \uC870\uC808.\n\n\uC774 \uC52C\uC758 EnemySpawner \uB97C \uC120\uD0DD\uD558\uACE0 Scene \uBDF0\uC758 \uC8FC\uD669 \uC6D0 \uD14C\uB450\uB9AC \uC810\uC744 \uB04C\uC5B4 \uBCF4\uC138\uC694."
  arrowKeys: 1
