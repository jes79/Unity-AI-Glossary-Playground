  m_text: "<color=#9BE89B>[Header(\"\uC774\uB3D9\")]</color>\n<color=#9BE89B>[Tooltip(\"\uC124\uBA85\")]</color>\n<color=#9BE89B>[SerializeField, Range(0f, 180f)]</color> private float orbitSpeed = 45f;\n<color=#9BE89B>[SerializeField, Min(0.1f)]</color> private float bobPeriod = 1f;\n<color=#9BE89B>[Space(12)] [Header(\"\uC678\uD615\")]</color>\n<color=#9BE89B>[SerializeField, TextArea(2, 4)]</color> private string memo;\n<color=#9BE89B>[field: SerializeField]</color> public int Level { get; private set; }\n\npublic float publicField;   <color=#FF8A65>// \uBCF4\uC774\uAE34 \uD558\uC9C0\uB9CC \uC5B4\uB514\uC11C\uB098 \uC218\uC815 \uAC00\uB2A5 \u2192 \uBE44\uAD8C\uC7A5</color>\n<color=#9BE89B>[HideInInspector]</color> public int hiddenValue;   // public \uC778\uB370 \uC228\uAE40\nprivate float notShown;   // \uC548 \uBCF4\uC784\n\n<color=#9BE89B>void OnValidate()</color> { \uAC12 \uAC80\uC99D }   <color=#9BE89B>[ContextMenu(\"\u2026\")]</color> \uBA54\uB274 \uCD94\uAC00\n<b>\uD575\uC2EC</b>: \uBC14\uAE65\uC5D0\uC11C \uBC14\uAFC0 \uD544\uC694 \uC5C6\uB294 \uAC12\uC740 <b>private + [SerializeField]</b>"
