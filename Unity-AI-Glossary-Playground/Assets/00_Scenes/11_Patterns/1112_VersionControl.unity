--- !u!114 &230958270
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 230958268}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dcb1b89f8ba15d848ae37de22bc05f02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlossaryDemo.Patterns.GuidePages
  titleText: {fileID: 1233979526}
  bodyText: {fileID: 844853272}
  pageText: {fileID: 254552732}
  titles:
  - "1. \uC800\uC7A5\uC18C \uB9CC\uB4E4\uAE30"
  - ".gitignore (\uC720\uB2C8\uD2F0\uC6A9)"
  - "Git LFS (\uD070 \uD30C\uC77C)"
  - "\uC77C\uC0C1 \uC791\uC5C5 \uD750\uB984"
  - "\uC52C\xB7\uD504\uB9AC\uD339 \uCDA9\uB3CC \uC904\uC774\uAE30"
  bodies:
  - "\u2022 \uD504\uB85C\uC81D\uD2B8 \uD3F4\uB354\uC5D0\uC11C <color=#9BE89B>git init</color> (\uB610\uB294 GitHub Desktop \uC73C\uB85C Add Local Repository)\n\u2022 Unity \uC124\uC815 \uD655\uC778: <b>Project Settings > Editor</b>\n  - Version Control Mode = <b>Visible Meta Files</b>\n  - Asset Serialization = <b>Force Text</b> (\uC52C\xB7\uD504\uB9AC\uD339\uC774 \uAE00\uC790\uB85C \uC800\uC7A5 \u2192 \uBE44\uAD50\xB7\uBCD1\uD569 \uAC00\uB2A5)\n\u2022 <b>.meta \uD30C\uC77C\uC740 \uBC18\uB4DC\uC2DC \uAC19\uC774 \uCEE4\uBC0B</b> (\uC5D0\uC14B GUID \uAC00 \uB4E4\uC5B4 \uC788\uC5B4 \uBE60\uC9C0\uBA74 \uCC38\uC870\uAC00 \uB04A\uAE40)"
  - "\u2022 GitHub \uC758 <b>Unity.gitignore</b> \uD15C\uD50C\uB9BF\uC744 \uC800\uC7A5\uC18C \uCD5C\uC0C1\uC704\uC5D0 <color=#9BE89B>.gitignore</color> \uB85C \uC800\uC7A5\n\u2022 \uD575\uC2EC: <color=#9BE89B>[Ll]ibrary/  [Tt]emp/  [Oo]bj/  [Bb]uild/  [Ll]ogs/  [Uu]ser[Ss]ettings/</color>\n  \u2192 Unity \uAC00 \uB2E4\uC2DC \uB9CC\uB4DC\uB294 \uD3F4\uB354\uB77C \uC62C\uB9AC\uBA74 \uC6A9\uB7C9\uB9CC \uCEE4\uC9C0\uACE0 \uCDA9\uB3CC\uC774 \uC7A6\uC544\uC9D0\n\u2022 <color=#9BE89B>*.csproj  *.sln  .vs/</color> \u2192 IDE \uAC00 \uC790\uB3D9 \uC0DD\uC131\n\u2022 \uC774\uBBF8 \uC62C\uB77C\uAC04 \uD30C\uC77C\uC740 \uBB34\uC2DC\uB418\uC9C0 \uC54A\uC74C \u2192 <color=#9BE89B>git rm -r --cached Library</color>\n\u2022 Unity \uD504\uB85C\uC81D\uD2B8\uAC00 \uD558\uC704 \uD3F4\uB354\uBA74 .gitignore \uACBD\uB85C\uB3C4 \uB9DE\uCDB0\uC57C \uD568 (\uC774 \uC800\uC7A5\uC18C\uB294 `**/[Ll]ibrary/` \uCC98\uB7FC ** \uC0AC\uC6A9)"
  - "\u2022 \uC774\uBBF8\uC9C0\xB7\uC0AC\uC6B4\uB4DC\xB73D \uBAA8\uB378 \uAC19\uC740 \uD070 \uBC14\uC774\uB108\uB9AC\uB294 Git \uAE30\uB85D\uC744 \uBB34\uAC81\uAC8C \uD568 \u2192 <b>Git LFS</b> \uB85C \uB530\uB85C \uC800\uC7A5\n\u2022 <color=#9BE89B>git lfs install</color>\n\u2022 <color=#9BE89B>git lfs track \"*.psd\" \"*.png\" \"*.wav\" \"*.mp3\" \"*.fbx\" \"*.ttf\"</color>\n\u2022 \uC704 \uBA85\uB839\uC774 .gitattributes \uC5D0 \uB2E4\uC74C\uCC98\uB7FC \uAE30\uB85D:\n  <color=#9BE89B>*.psd filter=lfs diff=lfs merge=lfs -text</color>\n\u2022 <color=#9BE89B>git add .gitattributes</color> \uB97C <b>\uB2E4\uB978 \uD30C\uC77C\uBCF4\uB2E4 \uBA3C\uC800</b> \uCEE4\uBC0B\n\u2022 GitHub \uBB34\uB8CC LFS \uC6A9\uB7C9\xB7\uB300\uC5ED\uD3ED \uC81C\uD55C \uD655\uC778"
  - "\u2022 <color=#9BE89B>git status</color>  \uBB34\uC5C7\uC774 \uBC14\uB00C\uC5C8\uB098\n\u2022 <color=#9BE89B>git add .</color>  \u2192  <color=#9BE89B>git commit -m \"\uC810\uD504 \uBC84\uD37C \uCD94\uAC00\"</color>\n\u2022 <color=#9BE89B>git push</color>  \uC6D0\uACA9(GitHub)\uC5D0 \uBC31\uC5C5\n\u2022 \uAE30\uB2A5\uB9C8\uB2E4 \uBE0C\uB79C\uCE58: <color=#9BE89B>git switch -c feature/inventory</color>\n\u2022 \uCEE4\uBC0B\uC740 \uC791\uAC8C, \uBA54\uC2DC\uC9C0\uB294 '\uBB34\uC5C7\uC744 \uC65C'\n\u2022 \uC544\uB798 \uBBF8\uB2C8 Git \uBC84\uD2BC\uC73C\uB85C \uC218\uC815 \u2192 \uCEE4\uBC0B \u2192 \uC608\uC804 \uC2DC\uC810 \uBCF4\uAE30\uB97C \uCCB4\uD5D8\uD574 \uBCF4\uC138\uC694"
  - "\u2022 \uAC19\uC740 \uC52C\uC744 \uB450 \uC0AC\uB78C\uC774 \uB3D9\uC2DC\uC5D0 \uACE0\uCE58\uBA74 \uCDA9\uB3CC\uC774 \uC7A6\uC74C \u2192 \uC791\uC5C5\uC744 \uD504\uB9AC\uD339 \uB2E8\uC704\uB85C \uB098\uB204\uAE30\n\u2022 Unity \uC758 <b>UnityYAMLMerge</b>(Smart Merge)\uB97C merge tool \uB85C \uB4F1\uB85D\uD558\uBA74 YAML \uBCD1\uD569\uC774 \uC26C\uC6CC\uC9D0\n\u2022 \uCEE4\uBC0B \uC804 Unity \uC5D0\uC11C <b>File > Save Project</b> (\uBCC0\uACBD\uC774 \uB514\uC2A4\uD06C\uC5D0 \uC368\uC84C\uB294\uC9C0)\n\u2022 Library \uB97C \uC9C0\uC6B4 \uB4A4 \uB2E4\uC2DC \uC5F4\uC5B4\uB3C4 \uC798 \uC5F4\uB9AC\uB294\uC9C0 = \uCEE4\uBC0B\uC774 \uC644\uC804\uD55C\uC9C0 \uD655\uC778\uD558\uB294 \uBC29\uBC95"
  arrowKeys: 1
