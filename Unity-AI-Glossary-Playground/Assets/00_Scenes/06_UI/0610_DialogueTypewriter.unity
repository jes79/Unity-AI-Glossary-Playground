  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlossaryDemo.UIDemo.DialogueTypewriter
  nameText: {fileID: 2038628092}
  bodyText: {fileID: 1942288106}
  nextIndicator: {fileID: 368705066}
  portrait: {fileID: 1763828146}
  portraitGlyph: {fileID: 1150929569}
  speedSlider: {fileID: 2006071598}
  skipLabel: {fileID: 2111696861}
  charsPerSecond: 30
  clickToComplete: 1
  punctuationPause: 0.15
  blipSource: {fileID: 1167720832}
  blipEvery: 2
  speakers:
  - "\uCD0C\uC7A5"
  - "\uC6A9\uC0AC"
  lines:
  - "\uC5B4\uC11C \uC624\uAC8C, \uC80A\uC740 \uC6A9\uC0AC\uC5EC. \uC6B0\uB9AC \uB9C8\uC744\uC5D0 \uC628 \uAC78 \uD658\uC601\uD558\uB124."
  - "\uC548\uB155\uD558\uC138\uC694! \uC774 \uADFC\uCC98\uC5D0 <color=#FFD54F>\uBAAC\uC2A4\uD130</color>\uAC00 \uB098\uC628\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4\uC694."
  - "\uADF8\uB807\uB2E4\uB124... \uBD81\uCABD \uB3D9\uAD74\uC5D0\uC11C \uB9E4\uC77C \uBC24 <color=#FF7043>\uC774\uC0C1\uD55C \uC6B8\uC74C\uC18C\uB9AC</color>\uAC00 \uB4E4\uB824\uC628\uB2E4\uB124."
  - "\uC81C\uAC00 \uAC00\uC11C \uD655\uC778\uD574 \uBCFC\uAC8C\uC694. \uD639\uC2DC \uCC59\uACA8 \uAC08 \uBB3C\uAC74\uC774 \uC788\uC744\uAE4C\uC694?"
  - "\uC774 <b>\uB0A1\uC740 \uD683\uBD88</b>\uC744 \uAC00\uC838\uAC00\uAC8C. \uB3D9\uAD74 \uC548\uC740 \uC544\uC8FC \uC5B4\uB461\uB2E4\uB124. \uBD80\uB514 \uC870\uC2EC\uD558\uAC8C!"
  speakerColors:
  - {r: 0.85, g: 0.55, b: 0.3, a: 1}
  - {r: 0.3, g: 0.6, b: 0.95, a: 1}
