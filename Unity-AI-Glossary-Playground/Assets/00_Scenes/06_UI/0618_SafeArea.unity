      m_Calls: []
  m_text: "<color=#9BE89B>Rect a = Screen.safeArea;</color>  // \uB178\uCE58\uB97C \uBE80 \uD53D\uC140 \uC0AC\uAC01\uD615\n<color=#9BE89B>rt.anchorMin = a.position / \uD654\uBA74\uD06C\uAE30;\nrt.anchorMax = (a.position + a.size) / \uD654\uBA74\uD06C\uAE30;</color>\nHUD \uB97C \uBAA8\uB450 \uC774 \uC624\uBE0C\uC81D\uD2B8 \uC790\uC2DD\uC73C\uB85C \u2192 \uB178\uCE58\uB97C \uC790\uB3D9\uC73C\uB85C \uD53C\uD568. \uD654\uBA74 \uD68C\uC804 \uC2DC \uB2E4\uC2DC \uACC4\uC0B0.\n\uC5D0\uB514\uD130\uB294 \uB178\uCE58\uAC00 \uC5C6\uC73C\uBBC0\uB85C \uC5EC\uAE30\uC120 \uBE44\uC728\uB85C \uD749\uB0B4 \uB0C4 (Device Simulator \uB85C \uC2E4\uC81C \uAE30\uAE30 \uD655\uC778)"
