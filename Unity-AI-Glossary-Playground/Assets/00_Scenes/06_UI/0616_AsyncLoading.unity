  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#9BE89B>var op = SceneManager.LoadSceneAsync(name);\nop.allowSceneActivation = false;</color>\n\n<color=#9BE89B>while (op.progress < 0.9f)\n{\n    bar.fillAmount = op.progress / 0.9f;\n    yield return null;\n}</color>\n\n// \uC900\uBE44 \uC644\uB8CC \u2192 \uD0A4 \uC785\uB825 \uAE30\uB2E4\uB838\uB2E4\uAC00\n<color=#9BE89B>op.allowSceneActivation = true;</color>\n\n\u2022 progress \uB294 <b>0.9 \uC5D0\uC11C \uBA48\uCDA4</b> (\uD65C\uC131\uD654 \uB300\uAE30)\n\u2022 \uC52C\uC740 Build Settings \uC5D0 \uB4F1\uB85D\uB418\uC5B4 \uC788\uC5B4\uC57C \uD568\n\u2022 \uB85C\uB529 UI \uB294 unscaledDeltaTime \uC73C\uB85C \uC6C0\uC9C1\uC784"
  m_isRightToLeft: 0
