  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlossaryDemo.GlossaryInfoPanel
  entryId: 0603
  controls: "\uAC00\uC0C1 \uD654\uBA74\uC774 \uCEE4\uC84C\uB2E4 \uC791\uC544\uC9D1\uB2C8\uB2E4 (Space : \uBA48\uCDA4/\uC7AC\uC0DD)\n\uCD08\uB85D \uC810\uC218 = Anchor \uC624\uB978\uCABD \uC704 \u2192 \uD56D\uC0C1 \uBAA8\uC11C\uB9AC\uC5D0 \uBD99\uC74C\n\uBE68\uAC15 \uC810\uC218 = Anchor \uAC00\uC6B4\uB370 \u2192 \uD654\uBA74\uC774 \uC791\uC544\uC9C0\uBA74 \uBC16\uC73C\uB85C \uBC00\uB9BC\nP : Pivot \uBCC0\uACBD (\uD68C\uC804 \uC911\uC2EC\uC774 \uBC14\uB01C)   \uB178\uB780 \u25C6 = Anchor \uC704\uCE58"
