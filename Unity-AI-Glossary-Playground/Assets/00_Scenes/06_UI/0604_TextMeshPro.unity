--- !u!114 &522519514
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 522519512}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dcb1b89f8ba15d848ae37de22bc05f02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlossaryDemo.Patterns.GuidePages
  titleText: {fileID: 2017311876}
  bodyText: {fileID: 979850110}
  pageText: {fileID: 823450232}
  titles:
  - "1. \uD3F0\uD2B8 \uD30C\uC77C \uC900\uBE44"
  - "2. Font Asset Creator \uC5F4\uAE30"
  - "3. \uD55C\uAE00 \uAE00\uC790 \uBC94\uC704 \uC9C0\uC815"
  - "4. \uB3D9\uC801 \uD3F0\uD2B8 (\uC774 \uC52C\uC758 \uBC29\uC2DD)"
  - "5. \uAE30\uBCF8 \uD3F0\uD2B8 / \uD3F4\uBC31 \uC9C0\uC815"
  - "6. \uC774 \uD504\uB85C\uC81D\uD2B8\uC5D0\uC11C\uB294 (\uCF54\uB4DC\uB85C \uC790\uB3D9 \uC0DD\uC131)"
  bodies:
  - "\u2022 \uD55C\uAE00\uC774 \uB4E4\uC5B4 \uC788\uB294 .ttf / .otf \uD30C\uC77C\uC744 Assets \uC544\uB798\uB85C \uBCF5\uC0AC\uD569\uB2C8\uB2E4.\n\u2022 <color=#FFB74D>\uB77C\uC774\uC120\uC2A4 \uD655\uC778</color>: \uAC8C\uC784\uC5D0 \uB123\uC5B4 \uBC30\uD3EC\uD574\uB3C4 \uB418\uB294 \uD3F0\uD2B8\uC778\uC9C0 \uD655\uC778 (\uC608: \uBCF8\uACE0\uB515\xB7\uB098\uB214\xB7Pretendard \uB294 OFL).\n\u2022 \uC2DC\uC2A4\uD15C \uD3F0\uD2B8(\uB9D1\uC740 \uACE0\uB515 \uB4F1)\uB294 \uC7AC\uBC30\uD3EC\uAC00 \uB9C9\uD600 \uC788\uB294 \uACBD\uC6B0\uAC00 \uB9CE\uC2B5\uB2C8\uB2E4."
  - "\u2022 \uBA54\uB274 <b>Window > TextMeshPro > Font Asset Creator</b>\n\u2022 Source Font File: 1\uB2E8\uACC4\uC758 \uD3F0\uD2B8\n\u2022 Sampling Point Size: Auto Sizing (\uB610\uB294 64~90)\n\u2022 Padding: 5~9 (\uC678\uACFD\uC120\xB7\uADF8\uB9BC\uC790\uB97C \uC4F8 \uAC70\uBA74 \uB109\uB109\uD788)\n\u2022 Packing Method: Optimum,  Atlas Resolution: 4096 x 4096\n\u2022 Render Mode: SDFAA"
  - "\u2022 Character Set: <b>Custom Range</b>\n  <color=#9BE89B>32-126,44032-55203,12593-12643,8200-9900</color>\n  (\uC601\uBB38\xB7\uC22B\uC790 + \uC644\uC131\uD615 \uD55C\uAE00 11,172\uC790 + \uC790\uBAA8 + \uAE30\uD638)\n\u2022 \uC6A9\uB7C9\uC774 \uBD80\uB2F4\uB418\uBA74 <b>Characters from File</b> \uB85C \uC790\uC8FC \uC4F0\uB294 2,350\uC790(KS X 1001) \uBAA9\uB85D\uB9CC \uB123\uC2B5\uB2C8\uB2E4.\n\u2022 Generate Font Atlas \u2192 Save \uB85C TMP_FontAsset(.asset) \uC800\uC7A5"
  - "\u2022 Project \uCC3D\uC5D0\uC11C \uD3F0\uD2B8 \uD30C\uC77C \uC6B0\uD074\uB9AD > <b>Create > TextMeshPro > Font Asset</b>\n\u2022 \uC778\uC2A4\uD399\uD130\uC5D0\uC11C Atlas Population Mode = <b>Dynamic</b>\n\u2022 \uBBF8\uB9AC \uAD7D\uC9C0 \uC54A\uACE0, \uD654\uBA74\uC5D0 \uCC98\uC74C \uB098\uC624\uB294 \uAE00\uC790\uB97C \uC2E4\uD589 \uC911\uC5D0 \uC544\uD2C0\uB77C\uC2A4\uC5D0 \uCD94\uAC00\uD569\uB2C8\uB2E4.\n  \u2192 \uC624\uB978\uCABD \uC544\uD2C0\uB77C\uC2A4 \uADF8\uB9BC\uC774 \uC785\uB825\uD560 \uB54C\uB9C8\uB2E4 \uCC44\uC6CC\uC9C0\uB294 \uAC83\uC774 \uC774 \uB3D9\uC791\uC785\uB2C8\uB2E4.\n\u2022 \uC6D0\uBCF8 \uD3F0\uD2B8 \uD30C\uC77C\uC774 \uBE4C\uB4DC\uC5D0 \uD3EC\uD568\uB418\uBBC0\uB85C \uC6A9\uB7C9\uC774 \uB298\uC5B4\uB098\uB294 \uC810\uC5D0 \uC8FC\uC758"
  - "\u2022 <b>Project Settings > TextMesh Pro > Settings</b>\n  - Default Font Asset: \uD55C\uAE00 \uD3F0\uD2B8 \uC5D0\uC14B \u2192 \uC0C8\uB85C \uB9CC\uB4DC\uB294 \uBAA8\uB4E0 TMP \uD14D\uC2A4\uD2B8\uC5D0 \uC801\uC6A9\n  - Fallback Font Assets: \uC601\uBB38 \uD3F0\uD2B8\uB97C \uBA54\uC778\uC73C\uB85C \uC4F0\uACE0 \uD55C\uAE00\uC744 \uD3F4\uBC31\uC73C\uB85C \uBD99\uC5EC\uB3C4 \uB428\n\u2022 \uD3F0\uD2B8 \uC5D0\uC14B\uC758 Fallback Font Assets \uBAA9\uB85D\uC5D0 \uB123\uC73C\uBA74 \uADF8 \uD3F0\uD2B8\uC5D0 \uC5C6\uB294 \uAE00\uC790\uB97C \uB300\uC2E0 \uCC3E\uC544 \uC90D\uB2C8\uB2E4."
  - "\u2022 <b>GlossaryKit.EnsureKoreanFont()</b>  (\uBA54\uB274 Tools > Glossary > Setup Korean Font)\n  1) Windows \uC758 \uB9D1\uC740 \uACE0\uB515(malgun.ttf)\uC744 Assets/06_Fonts \uB85C \uBCF5\uC0AC\n  2) <color=#9BE89B>TMP_FontAsset.CreateFontAsset(font, 64, 6, SDFAA, 2048, 2048, Dynamic)</color>\n  3) Assets/Resources/Fonts/GlossaryFont.asset \uB85C \uC800\uC7A5 (\uC544\uD2C0\uB77C\uC2A4\xB7\uBA38\uD2F0\uB9AC\uC5BC\uC744 \uD558\uC704 \uC5D0\uC14B\uC73C\uB85C)\n  4) TMP Settings \uC758 Default Font Asset \uC73C\uB85C \uC9C0\uC815\n\u2022 \uB7F0\uD0C0\uC784\uC5D0 \uB9CC\uB4DC\uB294 \uD14D\uC2A4\uD2B8\uB294 GlossaryInfoPanel.Font (Resources.Load) \uB97C \uB123\uC2B5\uB2C8\uB2E4.\n\u2022 malgun.ttf \uB294 \uC7AC\uBC30\uD3EC \uBD88\uAC00\uB77C .gitignore \uCC98\uB9AC, \uC5C6\uC73C\uBA74 \uBA54\uB274\uAC00 \uB2E4\uC2DC \uBCF5\uC0AC\uD569\uB2C8\uB2E4."
  arrowKeys: 1
