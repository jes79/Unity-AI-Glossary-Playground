  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FFD866><b>LOD Group 3\uB2E8\uACC4 \uC124\uC815</b></color>\n1. \uBE48 \uC624\uBE0C\uC81D\uD2B8(\uAC74\uBB3C \uB8E8\uD2B8)\uC5D0 <b>LOD Group</b> \uCD94\uAC00\n2. \uC790\uC2DD\uC73C\uB85C LOD0(\uACE0\uD488\uC9C8) / LOD1 / LOD2(\uC800\uD488\uC9C8) \uBAA8\uB378 \uBC30\uCE58\n3. LOD Group \uB9C9\uB300\uC758 \uAC01 \uCE78\uC744 \uD074\uB9AD \u2192 <b>Add</b> \uB85C \uB80C\uB354\uB7EC \uC9C0\uC815\n4. \uCE78 \uACBD\uACC4\uB97C \uB4DC\uB798\uADF8\uD574 \uC804\uD658 \uBE44\uC728 \uC870\uC808 (60% / 25% / 8%)\n5. Fade Mode = Cross Fade \uBA74 \uBD80\uB4DC\uB7FD\uAC8C \uC804\uD658\n\n<color=#9BE89B>\uCF54\uB4DC</color> (\uC774 \uC52C)\ngroup.SetLODs(new[] {\n  new LOD(0.6f, lod0Renderers),\n  new LOD(0.25f, lod1Renderers),\n  new LOD(0.08f, lod2Renderers) });\n\nProject Settings > Quality > <b>LOD Bias</b> \uB85C \uC804\uCCB4 \uC870\uC808"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8fef370121d393740a46a62c8052a3af, type: 2}
