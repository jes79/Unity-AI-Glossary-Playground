--- !u!114 &1492268017
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1492268015}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FFD866><b>\uC9C4\uC9DC URP 2D Light \uB85C \uD558\uB294 \uBC95</b></color>\n\uC774 \uD504\uB85C\uC81D\uD2B8 \uCE74\uBA54\uB77C\uB294 <b>Universal(3D) Renderer</b> \u2192 Light2D \uAC00 \uC548 \uBCF4\uC784.\n\uADF8\uB798\uC11C \uAC19\uC740 \uC6D0\uB9AC(\uBE5B \uD14D\uC2A4\uCC98 x \uC7A5\uBA74)\uB85C \uB300\uCCB4 \uAD6C\uD604\uD568.\n\n1. Create > Rendering > URP > <b>2D Renderer</b>\n2. URP Asset > Renderer List \uC5D0 \uCD94\uAC00\n   (\uB610\uB294 2D \uC804\uC6A9 URP Asset \uC744 \uB9CC\uB4E4\uC5B4 Graphics \uC5D0 \uC9C0\uC815)\n3. Camera > Rendering > <b>Renderer</b> = 2D Renderer\n4. \uC2A4\uD504\uB77C\uC774\uD2B8 \uBA38\uD2F0\uB9AC\uC5BC = <b>Sprite-Lit-Default</b>\n5. Light 2D (<b>Global</b>) Intensity 0.1 \u2192 \uC5B4\uB450\uC6B4 \uB358\uC804\n6. \uD683\uBD88\uB9C8\uB2E4 Light 2D (<b>Point</b>) Radius 3, \uC8FC\uD669\uC0C9\n7. \uAE5C\uBE61\uC784: intensity / pointLightOuterRadius \uB97C \uB178\uC774\uC988\uB85C\n\n<color=#9BE89B>\uB300\uCCB4 \uAD6C\uD604 \uAD6C\uC870</color>  Light Camera \u2192 RT(\uB77C\uC774\uD2B8 \uB9F5)\n\u2192 \uD654\uBA74 Quad \uAC00 Multiply \uB85C \uB36E\uC74C"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8fef370121d393740a46a62c8052a3af, type: 2}
  m_sharedMaterial: {fileID: 1618710855667448384, guid: 8fef370121d393740a46a62c8052a3af, type: 2}
