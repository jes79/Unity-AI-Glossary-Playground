--- !u!114 &1143120502
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1143120500}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FFD866><b>Baked \uC870\uBA85\uC73C\uB85C \uAD7D\uB294 \uBC95</b></color>\n1. \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB294 \uAC74\uBB3C \uC120\uD0DD \u2192 Inspector \uC624\uB978\uCABD \uC704 <b>Static</b> \uCCB4\uD06C\n   (\uCD5C\uC18C <b>Contribute GI</b>)\n2. \uB77C\uC774\uD2B8 \uC120\uD0DD \u2192 Light > <b>Mode</b>\n   \xB7 Realtime : \uB9E4 \uD504\uB808\uC784 \uACC4\uC0B0 (\uC6C0\uC9C1\uC774\uB294 \uBE5B)\n   \xB7 Baked : \uB77C\uC774\uD2B8\uB9F5\uC5D0 \uBBF8\uB9AC \uC800\uC7A5 (\uB7F0\uD0C0\uC784 \uBE44\uC6A9 \u2248 0)\n   \xB7 Mixed : \uC815\uC801\uC740 \uAD7D\uACE0 \uB3D9\uC801 \uBB3C\uCCB4\uC5D4 \uC2E4\uC2DC\uAC04\n3. \uC6C0\uC9C1\uC774\uB294 \uBB3C\uCCB4\uC6A9 <b>Light Probe Group</b> \uBC30\uCE58\n4. Window > Rendering > <b>Lighting</b> > Generate Lighting\n   (\uC774 \uC52C\uC740 \uBA54\uB274 Tools > Glossary > Rendering > Bake Lighting for 1003)\n5. \uACB0\uACFC: \uC52C \uD3F4\uB354\uC5D0 Lightmap-*.exr + LightingData \uC0DD\uC131\n\n<color=#9BE89B>\uAD00\uCC30</color>: \uAD7D\uAE30 \uC804/\uD6C4 Baked \uB77C\uC774\uD2B8\uC758 bakingOutput \uC774\n\uBC14\uB00C\uACE0 \uB77C\uC774\uD2B8\uB9F5 \uC7A5\uC218\uAC00 \uB298\uC5B4\uB0A8. \uAD7D\uAE30 \uD6C4 Baked \uAC00\uB85C\uB4F1\uC740\n\uC6C0\uC9C1\uC774\uB294 \uACF5\uC5D0 \uADF8\uB9BC\uC790\uB97C \uB9CC\uB4E4\uC9C0 \uC54A\uC74C (\uAD6C\uC6B4 \uBE5B\uC774\uB77C\uC11C)"
