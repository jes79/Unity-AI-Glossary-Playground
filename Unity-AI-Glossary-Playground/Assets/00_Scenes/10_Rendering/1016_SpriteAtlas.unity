  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FFD866><b>UI \uC544\uC774\uCF58\uC744 Sprite Atlas \uB85C \uBB36\uAE30</b></color>\n1. Project \uCC3D Create > 2D > <b>Sprite Atlas</b>\n2. Objects for Packing \uC5D0 \uC544\uC774\uCF58 <b>\uD3F4\uB354</b>\uB97C \uB4DC\uB798\uADF8\n3. Padding 2, Allow Rotation / Tight Packing \uB044\uAE30 (UI)\n4. <b>Pack Preview</b> \uB85C \uD55C \uC7A5\uC73C\uB85C \uBB36\uC778 \uBAA8\uC2B5 \uD655\uC778\n5. Project Settings > Editor > <b>Sprite Packer Mode</b>\n   = Sprite Atlas V1/V2 - Always Enabled (Play \uC911 \uC801\uC6A9)\n6. Image \uCEF4\uD3EC\uB10C\uD2B8\uB294 \uADF8\uB300\uB85C \uC6D0\uB798 \uC2A4\uD504\uB77C\uC774\uD2B8 \uC0AC\uC6A9 \u2192 \uC790\uB3D9\uC73C\uB85C Atlas \uD14D\uC2A4\uCC98 \uC0AC\uC6A9\n\n<color=#9BE89B>\uD655\uC778</color>: Frame Debugger \uC5D0\uC11C UI \uBC30\uCE58 \uC218, Stats \uC758 Batches\n<color=#9BE89B>\uCF54\uB4DC</color>: atlas.GetSprite(\"\uC774\uB984\") \uB85C \uAEBC\uB0B4\uAE30\n(\uC774 \uC52C\uC740 \uBE4C\uB354\uAC00 SpriteAtlasExtensions.Add \uB85C \uC0DD\uC131)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8fef370121d393740a46a62c8052a3af, type: 2}
