  m_text: "<color=#FFD866><b>ObjectPool<noparse><T></noparse> \uB85C \uBC14\uAFB8\uB294 \uBC95</b></color>\nusing UnityEngine.Pool;\n\npool = new ObjectPool<noparse><Bullet></noparse>(\n  () => Instantiate(prefab),        // \uBD80\uC871\uD560 \uB54C \uC0DD\uC131\n  b => b.gameObject.SetActive(true),  // Get\n  b => b.gameObject.SetActive(false), // Release\n  b => Destroy(b.gameObject),        // \uB118\uCE58\uBA74 \uD30C\uAD34\n  true, 20, 100);                     // \uAC80\uC0AC, \uAE30\uBCF8, \uCD5C\uB300\n\n\uBC1C\uC0AC:  var b = pool.Get(); b.Launch(...);\n\uB05D:    pool.Release(b);   // Destroy \uB300\uC2E0\n\n<color=#FC6>\uC8FC\uC758</color> \uAEBC\uB0BC \uB54C \uC704\uCE58\xB7\uC18D\uB3C4\xB7\uD0C0\uC774\uBA38 \uB4F1 \uC0C1\uD0DC\uB97C\n\uBC18\uB4DC\uC2DC \uCD08\uAE30\uD654 (\uC774\uC804 \uC0AC\uC6A9 \uD754\uC801\uC774 \uB0A8\uC544 \uC788\uC74C)"
