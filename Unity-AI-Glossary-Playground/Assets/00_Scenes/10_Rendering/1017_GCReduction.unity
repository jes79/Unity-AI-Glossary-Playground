      m_Calls: []
  m_text: "<noparse>void Update() {\n  var alive = enemies.Where(e => e.Hp > 0)\n                     .ToList();      // LINQ + \uC0C8 List\n  var scores = new List<int>();     // \uB9E4\uBC88 new\n  foreach (var e in alive) scores.Add(e.Score);\n  int total = scores.Sum();\n  text.text = \"\uC801: \" + alive.Count\n            + \" \uC810\uC218: \" + total;   // \uBB38\uC790\uC5F4 + \uBC15\uC2F1\n}</noparse>\n\n<color=#F99>\uBB38\uC81C</color>\n\xB7 LINQ / \uB78C\uB2E4 \u2192 \uD560\uB2F9\n\xB7 new List \uB9E4 \uD504\uB808\uC784\n\xB7 \uBB38\uC790\uC5F4 \uC774\uC5B4\uBD99\uC774\uAE30 \u2192 \uC0C8 string"
