  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><color=#7FB2FF>Unity Localization \uD328\uD0A4\uC9C0\uB85C \uD558\uB294 \uBC95</color></b>\n\n<b>1.</b> Package Manager \u2192 <b>Localization</b> \uC124\uCE58\n<b>2.</b> Project Settings \u203A Localization \u2192 Localization Settings \uC0DD\uC131\n    Locale Generator \uB85C <b>Korean (ko)</b>, <b>English (en)</b> \uCD94\uAC00\n<b>3.</b> Window \u203A Asset Management \u203A Localization Tables\n    \u2192 <b>String Table Collection</b> \uC0DD\uC131, \uD0A4\uC640 \uBC88\uC5ED \uC785\uB825\n    (\uC774 \uB370\uBAA8\uC758 LocalizationTable \uC5D0\uC14B\uACFC \uAC19\uC740 \uC5ED\uD560)\n<b>4.</b> \uD14D\uC2A4\uD2B8 \uC624\uBE0C\uC81D\uD2B8\uC5D0 <b>Localize String Event</b> \uCD94\uAC00\n    \u2192 \uD14C\uC774\uBE14\xB7\uD0A4 \uC120\uD0DD \u2192 Update String \uC744 TMP \uD14D\uC2A4\uD2B8\uC5D0 \uC5F0\uACB0\n    (\uC774 \uB370\uBAA8\uC758 LocalizedText \uC640 \uAC19\uC740 \uC5ED\uD560)\n<b>5.</b> \uC5B8\uC5B4 \uC804\uD658 \uCF54\uB4DC\n<color=#9BE89B><size=85%>LocalizationSettings.SelectedLocale =\n  LocalizationSettings.AvailableLocales.GetLocale(\"en\");</size></color>\n<b>6.</b> \uC22B\uC790 \uB07C\uC6CC \uB123\uAE30: <b>Smart String</b> \"\uBCF4\uC720 \uACE8\uB4DC: {0} G\"\n<b>7.</b> \uC5B8\uC5B4\uBCC4 \uD3F0\uD2B8\xB7\uC774\uBBF8\uC9C0: <b>Asset Table</b>\n    (\uD55C\uAE00\xB7\uC77C\uBCF8\uC5B4 \uB4F1\uC740 TMP \uD3F0\uD2B8\uC5D0 \uAE00\uC790\uAC00 \uC788\uC5B4\uC57C \uD568)\n\n<color=#9AA3B5><size=85%>\uBE60\uC9C4 \uBC88\uC5ED\uC740 Fallback(\uAE30\uBCF8 \uC5B8\uC5B4)\uC73C\uB85C \uD45C\uC2DC \xB7 \uC120\uD0DD\uD55C \uC5B8\uC5B4\uB294 PlayerPrefs \uC5D0 \uC800\uC7A5</size></color>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8fef370121d393740a46a62c8052a3af, type: 2}
