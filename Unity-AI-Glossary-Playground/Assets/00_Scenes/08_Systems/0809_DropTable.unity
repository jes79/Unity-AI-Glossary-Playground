  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlossaryDemo.GlossaryInfoPanel
  entryId: 0809
  controls: "\uBC84\uD2BC : 1\uD68C / 10\uD68C / 100\uD68C / 1000\uD68C \uBF51\uAE30\n\uC77C\uBC18 70 \xB7 \uD76C\uADC0 25 \xB7 \uC804\uC124 5 \uAC00\uC911\uCE58\uB85C \uB79C\uB364 \uB4DC\uB86D\n\uB9C9\uB300 \uADF8\uB798\uD504(\uD788\uC2A4\uD1A0\uADF8\uB7A8) = \uC2E4\uC81C\uB85C \uB098\uC628 \uBE44\uC728. \uD770 \uAC00\uB85C\uC120 = \uAE30\uB300 \uBE44\uC728\n\uC801\uAC8C \uBF51\uC73C\uBA74 \uB4E4\uCB49\uB0A0\uCB49, \uB9CE\uC774 \uBF51\uC744\uC218\uB85D \uAE30\uB300\uAC12\uC5D0 \uC218\uB834"
