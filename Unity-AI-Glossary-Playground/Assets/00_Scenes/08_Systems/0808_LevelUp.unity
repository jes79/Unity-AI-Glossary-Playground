  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlossaryDemo.GlossaryInfoPanel
  entryId: 0808
  controls: "\uBC84\uD2BC : \uACBD\uD5D8\uCE58 \uC5BB\uAE30 (+30 / +250 / +1000)\n\uD544\uC694 \uACBD\uD5D8\uCE58\uAC00 \uB808\uBCA8\uB9C8\uB2E4 1.2\uBC30\uC529 \uB298\uC5B4\uB0A8 (100 \u2192 120 \u2192 144 \u2192 173 ...)\n\uC544\uB798 \uADF8\uB798\uD504 = \uB808\uBCA8\uBCC4 \uD544\uC694 \uACBD\uD5D8\uCE58. [\uACE1\uC120 \uC804\uD658] \uC73C\uB85C \uC120\uD615 \uC99D\uAC00\uC640 \uBE44\uAD50\n\uD55C \uBC88\uC5D0 \uD070 \uACBD\uD5D8\uCE58\uB97C \uC5BB\uC73C\uBA74 \uC5EC\uB7EC \uB808\uBCA8\uC774 \uD55C\uAEBC\uBC88\uC5D0 \uC624\uB984"
