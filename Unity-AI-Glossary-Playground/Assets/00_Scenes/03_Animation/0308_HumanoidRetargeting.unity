  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. Mixamo \uC5D0\uC11C FBX \uB2E4\uC6B4\uB85C\uB4DC (\uCE90\uB9AD\uD130 / 'Without Skin' \uC560\uB2C8\uBA54\uC774\uC158)\n2. \uBAA8\uB378 FBX \uC120\uD0DD \u2192 Rig \uD0ED \u2192 Animation Type <b>Humanoid</b>\n   \u2192 Avatar Definition: Create From This Model \u2192 Apply\n3. Configure \uB85C \uBCF8 \uB9E4\uD551(Hips, Spine, LeftUpperArm\u2026) \uD655\uC778\n4. \uC560\uB2C8\uBA54\uC774\uC158 FBX \uB3C4 Humanoid \uB85C, Avatar Definition:\n   <b>Copy From Other Avatar</b> (\uB610\uB294 \uAC01\uC790 Create)\n5. \uB0B4 \uCE90\uB9AD\uD130 Animator \uC758 Avatar = \uB0B4 \uBAA8\uB378 Avatar,\n   \uCEE8\uD2B8\uB864\uB7EC\uC5D0 Mixamo \uD074\uB9BD \uC0C1\uD0DC \uCD94\uAC00\n\n<color=#9BE89B>\uC774 \uC52C</color>: \uB9E4\uD551 \uD45C(\uC67C\uCABD Hips \u2194 \uC624\uB978\uCABD pelvis \u2026)\uB85C\n\uD68C\uC804 \uBCC0\uD654\uB7C9\uC744 \uBCF5\uC0AC + \uC5C9\uB369\uC774 \uC774\uB3D9\uC744 \uB2E4\uB9AC \uAE38\uC774 \uBE44\uC728\uB85C \uBCF4\uC815\n= Humanoid Avatar \uAC00 \uB0B4\uBD80\uC5D0\uC11C \uD558\uB294 \uC77C\uC758 \uCD95\uC18C\uD310"
  m_isRightToLeft: 0
