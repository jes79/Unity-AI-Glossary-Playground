  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. \uBAA8\uB378 Rig = Humanoid, Animator \uB808\uC774\uC5B4 \uD1B1\uB2C8 \u2192 <b>IK Pass</b> \uCCB4\uD06C\n2. \uC2A4\uD06C\uB9BD\uD2B8\uC5D0\uC11C\n<color=#9FD0FF>void OnAnimatorIK(int layer) {\n  // \uBC1C \uC544\uB798\uB85C Raycast \uD574\uC11C hit \uC744 \uC5BB\uC740 \uB4A4\n  animator.SetIKPositionWeight(AvatarIKGoal.LeftFoot, 1f);\n  animator.SetIKPosition(AvatarIKGoal.LeftFoot, hit.point + up*\uBC1C\uB192\uC774);\n  animator.SetIKRotation(AvatarIKGoal.LeftFoot,\n    Quaternion.FromToRotation(up, hit.normal) * transform.rotation);\n}</color>\n3. \uC5C9\uB369\uC774(bodyPosition)\uB97C \uB0AE\uC740 \uBC1C \uCABD\uC73C\uB85C \uB0B4\uB824 \uC90C\nGeneric \uB9AC\uADF8: Animation Rigging \uD328\uD0A4\uC9C0 Two Bone IK Constraint\n\n<color=#9BE89B>\uC774 \uC52C</color>: \uAC19\uC740 \uACC4\uC0B0(\uCF54\uC0AC\uC778 \uBC95\uCE59 2\uBCF8 IK)\uC744 \uC9C1\uC811 \uAD6C\uD604"
  m_isRightToLeft: 0
