  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 Animator \uC758 <b>Apply Root Motion</b> \uCCB4\uD06C \u2192 \uD074\uB9BD\uC758 \uB8E8\uD2B8 \uC774\uB3D9\uC774 \uCE90\uB9AD\uD130\uB97C \uC6C0\uC9C1\uC784\n\u2022 \uC2A4\uD06C\uB9BD\uD2B8\uC5D0 <b>OnAnimatorMove()</b> \uAC00 \uC788\uC73C\uBA74 \uC801\uC6A9\uC744 \uC9C1\uC811 \uC81C\uC5B4\n  (\uC5EC\uAE30\uC120 \uAD6C\uB974\uAE30 \uC0C1\uD0DC\uC77C \uB54C\uB9CC animator.deltaPosition \uC744 \uB354\uD568)\n\u2022 Generic: Rig \uD0ED Root node \uC9C0\uC815 / Humanoid: \uC790\uB3D9(\uBB34\uAC8C\uC911\uC2EC)\n\u2022 \uD074\uB9BD Import \uC124\uC815 Root Transform Position(Y)\n  'Bake Into Pose' = \uB192\uC774\uB294 \uC790\uC138\uB85C, \uC774\uB3D9\uB9CC \uCD94\uCD9C\n\n\uAC77\uAE30\uB294 \uCF54\uB4DC, \uAD6C\uB974\uAE30\uB294 \uC560\uB2C8\uBA54\uC774\uC158: \uAD6C\uB974\uAE30 \uAC70\uB9AC\uAC00\n\uC560\uB2C8\uBA54\uC774\uC158\uACFC \uC815\uD655\uD788 \uC77C\uCE58(\uBC1C \uBBF8\uB044\uB7EC\uC9D0 \uC5C6\uC74C)"
  m_isRightToLeft: 0
