  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. Package Manager \u2192 <b>2D Animation</b> (+ 2D PSD Importer) \uC124\uCE58\n2. \uCE90\uB9AD\uD130 PSB/PNG \uC120\uD0DD \u2192 Sprite Editor \u2192 <b>Skinning Editor</b>\n3. Create Bone \uC73C\uB85C \uACE8\uBC18\u2192\uCC99\uCD94\u2192\uBA38\uB9AC, \uC5B4\uAE68\u2192\uD314\uAFC8\uCE58\u2192\uC190 \uBCF8 \uADF8\uB9AC\uAE30\n4. Auto Geometry \u2192 Auto Weights (\uBA54\uC2DC\uC640 \uBCF8 \uAC00\uC911\uCE58)\n5. \uC52C\uC5D0 \uB193\uACE0 <b>Sprite Skin</b> \uCEF4\uD3EC\uB10C\uD2B8 \u2192 Create Bones\n6. Animation \uCC3D\uC5D0\uC11C \uBCF8 \uD68C\uC804 \uD0A4\uD504\uB808\uC784 (\uC9C0\uAE08 \uC774 \uC52C\uACFC \uB3D9\uC77C)\n7. IK Manager 2D + Limb Solver \uB85C \uC190\uBC1C IK\n\n<color=#9BE89B>\uC774 \uC52C</color>: \uBD80\uC704\uBCC4 \uC2A4\uD504\uB77C\uC774\uD2B8\uB97C \uBCF8 Transform \uC544\uB798 \uB454\n\uCEF7\uC544\uC6C3 \uBC29\uC2DD. \uAC00\uC911\uCE58 \uBCC0\uD615(\uD718\uC5B4\uC9D0)\uB9CC \uC5C6\uACE0 \uC6D0\uB9AC\uB294 \uAC19\uC74C"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8fef370121d393740a46a62c8052a3af, type: 2}
