      m_Calls: []
  m_text: "\u2022 <b>\uD30C\uB77C\uBBF8\uD130</b> Speed(Float), Jump(Trigger)\n\u2022 <b>Idle</b>(\uAE30\uBCF8 \uC0C1\uD0DC, \uC8FC\uD669) \u2192 Run : Speed > 0.1\n\u2022 <b>Run</b> \u2192 Idle : Speed < 0.1\n\u2022 <b>Any State</b> \u2192 Jump : Jump \uD2B8\uB9AC\uAC70\n\u2022 <b>Jump</b> \u2192 Idle : Exit Time 0.9 (\uD074\uB9BD \uB05D\uB098\uBA74 \uBCF5\uADC0)\n\n\uC5D0\uB514\uD130\uC5D0\uC11C \uBCF4\uAE30: Assets/09_Generated/Animation/\n0301_Character.controller \uB354\uBE14\uD074\uB9AD \u2192 Animator \uCC3D\n\uD50C\uB808\uC774 \uC911 \uCE90\uB9AD\uD130\uB97C \uC120\uD0DD\uD558\uBA74 Animator \uCC3D\uC5D0 \uC9C4\uD589 \uB9C9\uB300\uAC00 \uBCF4\uC785\uB2C8\uB2E4."
  m_isRightToLeft: 0
