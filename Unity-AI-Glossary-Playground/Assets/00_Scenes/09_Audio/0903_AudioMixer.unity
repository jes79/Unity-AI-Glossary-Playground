  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. Project \u2192 Create \u2192 <b>Audio Mixer</b> \u2192 Window \u2192 Audio Mixer\n2. Groups \uC758 + \uB85C Master \uC544\uB798 <b>BGM</b>, <b>SFX</b> \uCD94\uAC00\n3. \uAC01 AudioSource \uC758 <b>Output</b> \uC5D0 \uADF8\uB8F9 \uC9C0\uC815\n4. \uADF8\uB8F9 \uC120\uD0DD \u2192 Inspector \uC758 Volume \uC6B0\uD074\uB9AD\n   \u2192 <b>Expose ... to script</b> \u2192 \uC774\uB984\uC744 BGMVolume \uC73C\uB85C\n5. \uCF54\uB4DC:\n<color=#9FD0FF>[SerializeField] AudioMixer mixer;\nvoid OnBgm(float v) =>\n  mixer.SetFloat(\"BGMVolume\", Mathf.Log10(v) * 20);</color>\n   \uC2AC\uB77C\uC774\uB354 \uCD5C\uC18C\uAC12\uC740 0.0001 (Log10(0) = -\u221E \uBC29\uC9C0)\n\n<color=#9BE89B>\uC774 \uC52C</color>: SimpleAudioMixer \uAC00 \uAC19\uC740 SetFloat/\uADF8\uB8F9 \uD2B8\uB9AC\uB97C \uD749\uB0B4"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8fef370121d393740a46a62c8052a3af, type: 2}
